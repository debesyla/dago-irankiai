Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8

# index.html imports ./src/*.mjs as ES modules; browsers refuse them without a
# JavaScript MIME type.
AddType text/javascript .mjs

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"

  # Scripts are referenced by fixed path (no content hash), so they must
  # revalidate together with the page or a deploy could pair new HTML with
  # stale modules.
  <FilesMatch "\.(html|mjs|js|css)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
